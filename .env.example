# Local PostgreSQL cluster (trust auth, no password)
DATABASE_URL=postgres://aural@127.0.0.1:5433/aural
TEST_DATABASE_URL=postgres://aural@127.0.0.1:5433/aural_test

# Docker alternative (docker compose up -d db)
# DATABASE_URL=postgres://aural:aural@localhost:5432/aural
# TEST_DATABASE_URL=postgres://aural:aural@localhost:5432/aural_test

# Provider engines (comma separated)
TTS_PROVIDERS=fixture
STT_PROVIDERS=fixture
DEFAULT_TTS_PROVIDER=fixture

# Local audio storage (dev values only)
STORAGE_DIR=.data/audio
STORAGE_SECRET=dev-secret
# Leave unset for origin-relative signed URLs (/api/v1/files/...).
# Set an absolute base only for a CDN or separate public host.
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
